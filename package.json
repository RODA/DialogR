{
    "private": true,
    "scripts": {
        "start": "node scripts/start-product.js",
        "check": "node scripts/check-build-ownership.js && node scripts/check-product.js",
        "build": "node scripts/build-product.js",
        "check:build-ownership": "node scripts/check-build-ownership.js",
        "webr:library": "node scripts/download-webr-library.js",
        "webr:manifest": "node scripts/generate-r-package-manifest.js",
        "test:package-compatibility": "node scripts/test-r-package-compatibility.js",
        "verify:electron-dialog": "node tests/electron/verify-DialogR-dialog-window.js",
        "dev:web": "node scripts/run-dialogforge-web.js --replace-port",
        "build:web": "node scripts/run-dialogforge-web.js --build-only",
        "serve:web": "node scripts/run-dialogforge-web.js --no-build --replace-port",
        "verify:web-deployment": "node scripts/verify-web-deployment.js",
        "verify:production": "node scripts/verify-production.js",
        "verify:production:electron": "node scripts/verify-production.js --electron-only",
        "verify:production:web": "node scripts/verify-production.js --web-only",
        "fetch:intel": "node scripts/fetch-intel-artifacts.js",
        "submit": "node scripts/macos-notarization.js submit",
        "history": "node scripts/macos-notarization.js history",
        "staple": "node scripts/macos-notarization.js staple",
        "publish": "node scripts/publish-artifacts.js",
        "docs:build": "node scripts/manual/build-html.js",
        "version:sync": "npm install --package-lock-only --ignore-scripts && npm run docs:build",
        "version": "npm run docs:build"
    },
    "devDependencies": {
        "@dialogforge/core": "file:../DialogForge/dist/sdk/core"
    },
    "name": "dialogr",
    "version": "1.0.24",
    "description": "A dialog-driven desktop application for statistical analysis in R.",
    "author": "Adrian Dusa",
    "contributors": [
        "RODA"
    ],
    "license": "SEE LICENSE IN LICENSE",
    "build": {
        "extraResources": [
            "LICENSE"
        ],
        "mac": {
            "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
            "extendInfo": {
                "NSHumanReadableCopyright": "© 2025-2026 Adrian Dusa — Academic Non-Commercial License (see LICENSE file for details)."
            },
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64"
                    ]
                }
            ]
        },
        "win": {
            "legalTrademarks": "Academic Non-Commercial License (see LICENSE file for details).",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        }
    },
    "product": {
        "id": "DialogR",
        "name": "DialogR",
        "appId": "org.roda.dialogr",
        "defaultRuntimeProvider": "r",
        "releaseTags": {
            "linuxIntel": "latest",
            "windowsIntel": "latest",
            "macosIntel": "latest",
            "macosSilicon": "latest",
            "webrVFS": "web"
        },
        "runtimeProviders": [
            "r",
            "server-r",
            "webr"
        ],
        "webRPackageLibrary": {
            "releaseRepository": "RODA/DialogR",
            "releaseTag": "web",
            "mountpoint": "/.dialogforge-library",
            "recommendedPackages": [
                "admisc",
                "declared",
                "DDIwR",
                "knitr",
                "evaluate",
                "highr",
                "xfun",
                "yaml"
            ],
            "requiredForNativeHelpExamples": [
                "knitr",
                "evaluate",
                "highr",
                "xfun",
                "yaml"
            ]
        }
    }
}
